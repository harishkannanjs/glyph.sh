---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { siteConfig } from '@/site.config';

// Fetch all published posts sorted by date descending
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title="Home" activePath="/">
  <div class="max-w-[720px] mx-auto px-4 md:px-0 py-8">
    <div class="flex flex-col w-full">
      <!-- Terminal Header Buffer -->
      <div class="flex flex-col py-6 mb-4">
        <div class="flex items-center gap-2 mb-2 text-[11px] text-outline font-mono">
          <span class="inline-block w-2 h-2 bg-primary rounded-none"></span>
          <span>INDEX BUFFER // SEC_SYS_LOG</span>
          <span class="text-outline-variant">·</span>
          <span class="text-on-surface-variant font-mono">STATUS: OK</span>
        </div>
        <p class="text-[14px] text-on-surface-variant leading-relaxed font-mono">
          <span class="text-primary font-bold mr-1">&gt;</span>{siteConfig.description}
        </p>
      </div>

      <!-- Post List -->
      <div class="flex flex-col space-y-6">
        {allPosts.map((post, idx) => (
          <PostCard post={post} showDivider={idx > 0} />
        ))}
        {allPosts.length === 0 && (
          <div class="p-8 text-center text-outline font-mono text-[13px] border border-outline-variant">
            No posts published in this buffer yet.
          </div>
        )}
      </div>

      <!-- Bottom Buffer Bar & Search Shortcut -->
      <div class="mt-8 p-3 bg-surface-container-low border border-outline-variant rounded-[2px] flex items-center justify-between text-[11px] font-mono">
        <div class="flex items-center gap-2 text-on-surface-variant">
          <span class="text-primary font-bold">&gt;_</span>
          <span>Press <kbd class="px-1.5 py-0.5 bg-surface-container-high text-primary rounded-[2px] border border-outline-variant">/</kbd> anywhere to search CVEs, tags &amp; teardowns</span>
        </div>
        <button
          type="button"
          data-open-search
          class="text-outline hover:text-primary transition-colors cursor-pointer"
        >
          [Open Shell]
        </button>
      </div>
    </div>
  </div>
</BaseLayout>
