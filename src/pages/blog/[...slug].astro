---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '@/layouts/BlogPostLayout.astro';
import Spoiler from '@/components/Spoiler.astro';
import Mermaid from '@/components/Mermaid.astro';
import Asciinema from '@/components/Asciinema.astro';
import Sidenote from '@/components/Sidenote.astro';
import Footnotes from '@/components/Footnotes.astro';

export async function getStaticPaths() {
  const isProd = import.meta.env.PROD;
  const posts = await getCollection('blog', ({ data }) => {
    // Strictly exclude drafts in production builds per brief
    return isProd ? !data.draft : true;
  });

  posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  const paths: {
    params: { slug: string };
    props: { post: (typeof posts)[0]; allPosts: typeof posts; prevPost: (typeof posts)[0] | null; nextPost: (typeof posts)[0] | null };
  }[] = [];
  const registered = new Set<string>();

  posts.forEach((post, index) => {
    const prevPost = index < posts.length - 1 ? posts[index + 1] : null;
    const nextPost = index > 0 ? posts[index - 1] : null;

    const addRoute = (candidate?: string | null) => {
      if (!candidate) return;
      const normalized = candidate.replace(/\\/g, '/').replace(/^\/+|\/+$/g, '');
      if (!normalized) return;

      if (!registered.has(normalized)) {
        registered.add(normalized);
        paths.push({
          params: { slug: normalized },
          props: { post, allPosts: posts, prevPost, nextPost },
        });
      }

      const lower = normalized.toLowerCase();
      if (!registered.has(lower)) {
        registered.add(lower);
        paths.push({
          params: { slug: lower },
          props: { post, allPosts: posts, prevPost, nextPost },
        });
      }
    };

    const fullSlug = post.id.replace(/\.(md|mdx)$/, '');

    // 1. Primary slug (e.g. standalone/clipt-readme, series/windows-internals-exploitation/01-anticheat-dr7-hooks)
    addRoute(fullSlug);

    // 2. Leaf slug alias (e.g. 01-anticheat-dr7-hooks, coppelia-sim-rust, clipt-readme)
    const parts = fullSlug.split('/');
    const leaf = parts[parts.length - 1];
    addRoute(leaf);

    // 3. Clean slug without numeric prefix (e.g. anticheat-dr7-hooks)
    const cleanLeaf = leaf.replace(/^(?:part[-_]?)?\d+[-_]/i, '');
    if (cleanLeaf) {
      addRoute(cleanLeaf);
    }

    // 4. Raw file path aliases (e.g. standalone/clipt-README, clipt-README)
    if (post.filePath) {
      const rawRel = post.filePath
        .replace(/\\/g, '/')
        .replace(/^(?:.*\/)?blogs\//i, '')
        .replace(/\.(md|mdx)$/i, '');
      addRoute(rawRel);
      const rawLeaf = rawRel.split('/').pop();
      if (rawLeaf) {
        addRoute(rawLeaf);
      }
    }
  });

  return paths;
}

const { post, allPosts, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPostLayout
  post={post}
  allPosts={allPosts}
  headings={headings}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content
    components={{
      Spoiler,
      Mermaid,
      Asciinema,
      Sidenote,
      Footnotes,
    }}
  />
</BlogPostLayout>
