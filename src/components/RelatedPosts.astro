---
import type { CollectionEntry } from 'astro:content';
import { getRelativePath } from '@/site.config';

interface Props {
  currentPost: CollectionEntry<'blog'>;
  allPosts: CollectionEntry<'blog'>[];
}

const { currentPost, allPosts } = Astro.props;

// Find posts with shared tags, excluding self and drafts
const relatedPosts = allPosts
  .filter((p) => p.id !== currentPost.id && !p.data.draft)
  .map((p) => {
    const sharedTags = p.data.tags.filter((t) => currentPost.data.tags.includes(t));
    return { post: p, sharedCount: sharedTags.length };
  })
  .filter((item) => item.sharedCount > 0)
  .sort((a, b) => b.sharedCount - a.sharedCount || b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime())
  .slice(0, 3)
  .map((item) => item.post);
---

{relatedPosts.length > 0 && (
  <section class="my-10 pt-6 border-t border-outline-variant font-mono text-[12px]">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2 text-outline text-[11px] uppercase tracking-wider">
        <span class="text-primary font-bold">&gt;</span>
        <span>Related Teardowns &amp; Research</span>
      </div>
      <span class="text-[10px] text-outline">[by tag affinity]</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      {relatedPosts.map((post) => {
        const slug = post.id.replace(/\.(md|mdx)$/, '');
        const filename = post.id.split('/').pop()?.replace(/\.(md|mdx)$/, '') + '.md';
        return (
          <a
            href={getRelativePath(`/blog/${slug}`)}
            class="min-w-0 overflow-hidden p-3 bg-surface-container-low border border-outline-variant hover:border-primary rounded-[2px] transition-colors flex flex-col justify-between group"
          >
            <div class="min-w-0 w-full">
              <div
                class="text-[10px] text-primary mb-1 font-mono truncate w-full block"
                title={`$ cat ${slug}.md`}
              >
                $ cat {filename}
              </div>
              <h4 class="text-on-surface group-hover:text-primary font-medium text-[13px] leading-snug line-clamp-2 transition-colors break-words">
                {post.data.title}
              </h4>
            </div>
            <div class="mt-3 text-[10px] text-outline flex items-center justify-between min-w-0 pt-1">
              <span class="shrink-0">{new Date(post.data.pubDate).toISOString().split('T')[0]}</span>
              <span class="text-primary font-bold group-hover:translate-x-0.5 transition-transform shrink-0">→</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}
