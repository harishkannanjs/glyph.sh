---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  mode?: 'rail' | 'inline';
}

const { headings, mode = 'rail' } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length > 0 && (
  <>
    {mode === 'rail' ? (
      <aside class="hidden lg:block w-[240px] shrink-0 self-stretch">
        <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto p-4 bg-surface-container-low border border-outline-variant rounded-[2px] font-mono text-[12px]">
          <div class="flex items-center gap-1.5 pb-2 mb-2 border-b border-outline-variant text-[11px] text-outline uppercase tracking-wider">
            <span class="text-primary font-bold">&gt;</span>
            <span>Table of Contents</span>
          </div>
          <nav class="flex flex-col space-y-1.5">
            {tocHeadings.map((h) => (
              <a
                href={`#${h.slug}`}
                data-toc-link={h.slug}
                class={`toc-link text-on-surface-variant hover:text-primary transition-colors leading-relaxed block ${
                  h.depth === 3 ? 'pl-3 text-[11px]' : 'font-medium'
                }`}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </div>
      </aside>
    ) : (
      <>
        <!-- Inline collapsible disclosure at the top of the article -->
        <details class="lg:hidden my-6 p-3 bg-surface-container-low border border-outline-variant rounded-[2px] font-mono text-[12px]">
          <summary class="flex items-center justify-between cursor-pointer font-medium text-on-surface hover:text-primary transition-colors select-none">
            <span class="flex items-center gap-2">
              <span class="text-primary font-bold">&gt;</span>
              <span>Table of Contents ({tocHeadings.length} sections)</span>
            </span>
            <span class="text-outline text-[11px]">[Toggle]</span>
          </summary>
          <nav class="mt-3 pt-3 border-t border-outline-variant flex flex-col space-y-1.5 pl-2">
            {tocHeadings.map((h) => (
              <a
                href={`#${h.slug}`}
                class={`text-on-surface-variant hover:text-primary transition-colors ${
                  h.depth === 3 ? 'pl-3 text-[11px]' : 'font-medium'
                }`}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </details>

        <!-- Floating mobile TOC button that stays with the reader while scrolling down -->
        <div class="lg:hidden fixed bottom-6 right-6 z-40">
          <button
            type="button"
            id="mobile-toc-btn"
            class="px-3 py-1.5 bg-surface-container-high border border-primary text-primary font-mono text-[11px] rounded-[2px] flex items-center gap-1.5 cursor-pointer shadow-none select-none hover:bg-surface-container-highest transition-colors"
            aria-label="Toggle Table of Contents"
          >
            <span class="font-bold">&gt;</span>
            <span>TOC</span>
          </button>
        </div>

        <!-- Mobile floating TOC modal/overlay -->
        <div
          id="mobile-toc-modal"
          class="hidden lg:hidden fixed inset-0 z-50 bg-background/80 backdrop-blur-sm flex items-end sm:items-center justify-center p-4"
        >
          <div class="w-full max-w-[420px] bg-surface-container-low border border-outline-variant rounded-[2px] p-4 font-mono text-[12px] max-h-[70vh] flex flex-col">
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-outline-variant">
              <span class="text-primary font-bold">&gt; Table of Contents</span>
              <button type="button" id="mobile-toc-close" class="text-outline hover:text-on-surface text-[11px] cursor-pointer">[Close]</button>
            </div>
            <nav class="overflow-y-auto space-y-1.5 py-1">
              {tocHeadings.map((h) => (
                <a
                  href={`#${h.slug}`}
                  class={`mobile-toc-link block text-on-surface-variant hover:text-primary transition-colors ${
                    h.depth === 3 ? 'pl-3 text-[11px]' : 'font-medium'
                  }`}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </div>
        </div>
      </>
    )}
  </>
)}

<script is:inline>
  function initTocHighlight() {
    const links = document.querySelectorAll('.toc-link');
    const mobileLinks = document.querySelectorAll('.mobile-toc-link');
    
    // Mobile TOC toggle logic
    const mobileBtn = document.getElementById('mobile-toc-btn');
    const mobileModal = document.getElementById('mobile-toc-modal');
    const mobileClose = document.getElementById('mobile-toc-close');

    if (mobileBtn && mobileModal) {
      mobileBtn.onclick = () => mobileModal.classList.remove('hidden');
      if (mobileClose) {
        mobileClose.onclick = () => mobileModal.classList.add('hidden');
      }
      mobileModal.onclick = (e) => {
        if (e.target === mobileModal) mobileModal.classList.add('hidden');
      };
      mobileLinks.forEach((l) => {
        l.onclick = () => mobileModal.classList.add('hidden');
      });
    }

    if (links.length === 0) return;

    const headingElements = [];
    links.forEach((link) => {
      const slug = link.getAttribute('data-toc-link');
      if (slug) {
        const el = document.getElementById(slug);
        if (el) headingElements.push({ slug, el });
      }
    });

    function highlightCurrent() {
      const scrollPos = window.scrollY + 140;
      let currentSlug = '';

      for (let i = 0; i < headingElements.length; i++) {
        if (headingElements[i].el.offsetTop <= scrollPos) {
          currentSlug = headingElements[i].slug;
        } else {
          break;
        }
      }

      links.forEach((link) => {
        const slug = link.getAttribute('data-toc-link');
        if (slug === currentSlug) {
          link.classList.add('text-primary', 'font-bold');
          link.classList.remove('text-on-surface-variant');
        } else {
          link.classList.remove('text-primary', 'font-bold');
          link.classList.add('text-on-surface-variant');
        }
      });
    }

    window.addEventListener('scroll', highlightCurrent, { passive: true });
    highlightCurrent();
  }

  initTocHighlight();
  document.addEventListener('astro:after-swap', initTocHighlight);
</script>
