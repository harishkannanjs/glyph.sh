---
// CopyLinkButton.astro: Copy current blog post page link to clipboard
---

<div class="relative group inline-flex">
  <button
    type="button"
    id="copy-link-btn"
    class="flex items-center justify-center w-7 h-7 bg-surface-container border border-outline-variant hover:border-primary text-on-surface-variant hover:text-primary rounded-[2px] transition-colors cursor-pointer select-none"
    title="Copy page link"
    aria-label="Copy page link"
  >
    <!-- Default Chain Link SVG -->
    <svg
      id="copy-link-icon-default"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="w-3.5 h-3.5"
    >
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
    </svg>

    <!-- Success Checkmark SVG -->
    <svg
      id="copy-link-icon-check"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="w-3.5 h-3.5 text-primary hidden"
    >
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
  </button>

  <!-- Floating Hover Description Tooltip -->
  <span
    id="copy-link-tooltip"
    class="pointer-events-none absolute -bottom-7 left-1/2 -translate-x-1/2 whitespace-nowrap bg-surface-container-highest border border-outline-variant text-[10px] text-on-surface px-1.5 py-0.5 rounded-[2px] opacity-0 group-hover:opacity-100 transition-opacity z-30 font-mono select-none"
  >
    Copy page link
  </span>
</div>

<script is:inline>
  (function () {
    function initCopyLink() {
      const btn = document.getElementById('copy-link-btn');
      const iconDefault = document.getElementById('copy-link-icon-default');
      const iconCheck = document.getElementById('copy-link-icon-check');
      const tooltip = document.getElementById('copy-link-tooltip');

      if (!btn) return;

      btn.onclick = async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          iconDefault?.classList.add('hidden');
          iconCheck?.classList.remove('hidden');
          if (tooltip) tooltip.textContent = 'Link copied!';

          setTimeout(() => {
            iconDefault?.classList.remove('hidden');
            iconCheck?.classList.add('hidden');
            if (tooltip) tooltip.textContent = 'Copy page link';
          }, 2000);
        } catch (err) {
          console.error('Failed to copy page link:', err);
        }
      };
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCopyLink);
    } else {
      initCopyLink();
    }
    document.addEventListener('astro:page-load', initCopyLink);
  })();
</script>
