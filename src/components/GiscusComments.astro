---
import { siteConfig } from '@/site.config';

interface Props {
  postTitle?: string;
  postSlug?: string;
}

const { postTitle } = Astro.props;

const giscusConfig = siteConfig.giscus;
const isConfigured = Boolean(
  giscusConfig?.enabled &&
  giscusConfig?.repo &&
  giscusConfig?.repoId &&
  giscusConfig?.categoryId
);

// Derive clean GitHub repository and discussions link if user has configured githubUrl or giscus.repo
const repoPath = giscusConfig?.repo || (siteConfig.githubUrl ? siteConfig.githubUrl.replace(/^https?:\/\/github\.com\//, '') : '');
const discussionsUrl = repoPath ? `https://github.com/${repoPath}/discussions` : (siteConfig.githubUrl ? `${siteConfig.githubUrl}` : '');
const topicDiscussionUrl = postTitle && discussionsUrl
  ? `${discussionsUrl}/new?category=${encodeURIComponent(giscusConfig?.category || 'general')}&title=${encodeURIComponent(`[Discussion] ${postTitle}`)}`
  : discussionsUrl;
---

<section class="mt-12 pt-8 border-t border-outline-variant font-mono" id="comments">
  <div class="flex items-center justify-between pb-4 mb-4 border-b border-outline-variant/60 text-[12px] text-outline">
    <div class="flex items-center gap-2 uppercase tracking-wider">
      <span class="text-primary font-bold">&gt;</span>
      <span>Discussions &amp; Peer Review</span>
    </div>
    <span class="text-on-surface-variant text-[11px]">powered by giscus (github discussions)</span>
  </div>

  {isConfigured ? (
    <div id="giscus-container" class="min-h-[160px]">
      <!-- Giscus script injected client-side with proper theme -->
    </div>
  ) : (
    <div class="p-4 bg-surface-container-low border border-outline-variant rounded-[2px] text-[12px] space-y-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2 text-primary font-semibold">
          <span class="font-bold">&gt;</span>
          <span class="text-on-surface">Discussions (GitHub Discussions)</span>
        </div>
        <span class="text-[10px] text-primary border border-primary/30 px-1.5 py-0.5 rounded-[2px]">zero-server</span>
      </div>

      <p class="text-on-surface-variant leading-relaxed text-[12px]">
        Comments and discussions are stored safely directly inside your GitHub repository under the <strong>Discussions</strong> tab.
        Visitors can comment using their GitHub accounts with full markdown, code formatting, and emoji reactions.
      </p>

      {topicDiscussionUrl ? (
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href={topicDiscussionUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 bg-surface-container border border-outline-variant hover:border-primary text-primary hover:underline text-[11px] rounded-[2px] inline-flex items-center gap-1.5 transition-colors cursor-pointer"
          >
            <span>Open GitHub Discussions</span>
            <span>↗</span>
          </a>
        </div>
      ) : null}

      <div class="pt-2 border-t border-outline-variant/60 text-[11px] text-outline leading-relaxed break-words">
        <span># To embed comments directly on this page: enable Discussions on your GitHub repository, visit <a href="https://giscus.app" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">giscus.app ↗</a> to obtain your repoId and categoryId, then configure them in <code class="text-primary">profile.json</code> or via the localhost Profile editor.</span>
      </div>
    </div>
  )}
</section>

{isConfigured && (
  <script is:inline define:vars={{ giscusConfig }}>
    function loadGiscus() {
      const container = document.getElementById('giscus-container');
      if (!container) return;

      container.innerHTML = '';
      const isDark = document.documentElement.classList.contains('dark');
      const theme = isDark ? 'transparent_dark' : 'light';

      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.setAttribute('data-repo', giscusConfig.repo);
      script.setAttribute('data-repo-id', giscusConfig.repoId);
      script.setAttribute('data-category', giscusConfig.category || 'General');
      script.setAttribute('data-category-id', giscusConfig.categoryId);
      script.setAttribute('data-mapping', 'pathname');
      script.setAttribute('data-strict', '0');
      script.setAttribute('data-reactions-enabled', '1');
      script.setAttribute('data-emit-metadata', '0');
      script.setAttribute('data-input-position', 'bottom');
      script.setAttribute('data-theme', theme);
      script.setAttribute('data-lang', 'en');
      script.crossOrigin = 'anonymous';
      script.async = true;

      container.appendChild(script);
    }

    function handleThemeChange(e) {
      const nextTheme = e.detail?.theme === 'light' ? 'light' : 'transparent_dark';
      const iframe = document.querySelector('iframe.giscus-frame');
      if (iframe && iframe.contentWindow) {
        iframe.contentWindow.postMessage(
          { giscus: { setConfig: { theme: nextTheme } } },
          'https://giscus.app'
        );
      }
    }

    loadGiscus();
    window.addEventListener('theme-change', handleThemeChange);
    document.addEventListener('astro:page-load', loadGiscus);
  </script>
)}
