---
import { siteConfig } from '@/site.config';
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-surface border-t border-outline-variant pt-12 pb-12 mt-16 transition-colors">
  <div class="max-w-[1040px] mx-auto px-4 md:px-8 grid grid-cols-1 md:grid-cols-3 gap-8 items-baseline text-[13px] font-mono">
    <!-- Column 1: Copyright & Subtitle -->
    <div class="text-on-surface-variant">
      <p class="text-on-surface font-medium">© {currentYear} {siteConfig.author}</p>
      <p class="text-label-sm text-outline mt-1">{siteConfig.description}</p>
    </div>

    <!-- Column 2: Plain Text / Terminal Social Coordinates -->
    <div class="flex flex-wrap items-center gap-3 text-on-surface-variant">
      <a
        href={siteConfig.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-primary hover:underline underline-offset-4 transition-colors flex items-center gap-1"
      >
        <span>GitHub</span>
      </a>
      <span class="text-outline">·</span>
      <a
        href={siteConfig.twitterUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-primary hover:underline underline-offset-4 transition-colors flex items-center gap-1"
      >
        <span>Twitter</span>
      </a>
      <span class="text-outline">·</span>
      <a
        href={`mailto:${siteConfig.email}`}
        class="hover:text-primary hover:underline underline-offset-4 transition-colors flex items-center gap-1"
      >
        <span>Email</span>
      </a>
      <span class="text-outline">·</span>
      <a
        href="/feed.xml"
        class="hover:text-primary hover:underline underline-offset-4 transition-colors flex items-center gap-1 text-primary"
      >
        <span>RSS</span>
      </a>
    </div>

    <!-- Column 3: Engine Specs -->
    <div class="md:text-right text-[11px] text-outline">
      <p>Built with Astro &amp; Tailwind</p>
      <p class="text-outline hover:text-on-surface-variant transition-colors mt-0.5">JetBrains Mono Typeface</p>
    </div>
  </div>
</footer>
