---
import { siteConfig } from '@/site.config';
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-surface border-t border-outline-variant py-8 mt-16 transition-colors">
  <div class="max-w-[1040px] mx-auto px-4 md:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[13px] font-mono">
    <!-- Left: Author & Copyright -->
    <div class="text-on-surface-variant flex items-center gap-2">
      <span class="text-primary font-bold">&gt;</span>
      <span class="text-on-surface font-medium">© {currentYear} {siteConfig.author}</span>
    </div>

    <!-- Right: Terminal Social & Feed Coordinates -->
    <div class="flex flex-wrap items-center justify-center sm:justify-end gap-3 text-on-surface-variant text-[12px]">
      <a
        href={siteConfig.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-primary hover:underline underline-offset-4 transition-colors flex items-center gap-1"
      >
        <span>GitHub</span>
      </a>
      <span class="text-outline">·</span>
      <a
        href={siteConfig.twitterUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-primary hover:underline underline-offset-4 transition-colors flex items-center gap-1"
      >
        <span>Twitter</span>
      </a>
      <span class="text-outline">·</span>
      <a
        href={`mailto:${siteConfig.email}`}
        class="hover:text-primary hover:underline underline-offset-4 transition-colors flex items-center gap-1"
      >
        <span>Email</span>
      </a>
      <span class="text-outline">·</span>
      <a
        href="/feed.xml"
        class="hover:text-primary hover:underline underline-offset-4 transition-colors flex items-center gap-1 text-primary"
      >
        <span>RSS</span>
      </a>
    </div>
  </div>
</footer>
