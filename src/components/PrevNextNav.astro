---
import type { CollectionEntry } from 'astro:content';

interface Props {
  prevPost?: CollectionEntry<'blog'> | null;
  nextPost?: CollectionEntry<'blog'> | null;
}

const { prevPost, nextPost } = Astro.props;
---

{(prevPost || nextPost) && (
  <div class="my-10 pt-6 border-t border-outline-variant grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-[12px]">
    <!-- Previous Post -->
    {prevPost ? (
      <a
        href={`/blog/${prevPost.id.replace(/\.(md|mdx)$/, '')}`}
        class="min-w-0 overflow-hidden group p-3 bg-surface-container-low border border-outline-variant hover:border-primary rounded-[2px] transition-colors flex flex-col justify-between"
      >
        <div class="flex items-center gap-1 text-[11px] text-outline group-hover:text-primary transition-colors shrink-0">
          <span>←</span>
          <span>PREVIOUS ENTRY</span>
        </div>
        <div class="mt-2 text-on-surface group-hover:text-primary font-medium line-clamp-2 transition-colors break-words">
          {prevPost.data.title}
        </div>
      </a>
    ) : (
      <div></div>
    )}

    <!-- Next Post -->
    {nextPost ? (
      <a
        href={`/blog/${nextPost.id.replace(/\.(md|mdx)$/, '')}`}
        class="min-w-0 overflow-hidden group p-3 bg-surface-container-low border border-outline-variant hover:border-primary rounded-[2px] transition-colors flex flex-col justify-between sm:text-right"
      >
        <div class="flex items-center justify-end gap-1 text-[11px] text-outline group-hover:text-primary transition-colors shrink-0">
          <span>NEXT ENTRY</span>
          <span>→</span>
        </div>
        <div class="mt-2 text-on-surface group-hover:text-primary font-medium line-clamp-2 transition-colors break-words">
          {nextPost.data.title}
        </div>
      </a>
    ) : (
      <div></div>
    )}
  </div>
)}
