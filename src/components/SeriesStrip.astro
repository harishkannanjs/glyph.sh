---
import type { SeriesInfo } from '@/lib/series';

interface Props {
  seriesInfo: SeriesInfo;
}

const { seriesInfo } = Astro.props;
---

<div class="my-6 p-3 bg-surface-container-low border border-outline-variant rounded-[2px] flex flex-wrap items-center justify-between gap-3 font-mono text-[12px]">
  <div class="flex flex-wrap items-center gap-1.5 text-on-surface-variant min-w-0">
    <span class="text-primary font-bold shrink-0"># Series:</span>
    <span class="shrink-0">Part {seriesInfo.currentPart} of {seriesInfo.totalParts} in</span>
    <span class="text-on-surface font-medium break-words">'{seriesInfo.name}'</span>
  </div>

  <div class="flex items-center gap-1.5 flex-wrap shrink-0">
    {seriesInfo.parts.map((part) => (
      part.isCurrent ? (
        <span
          class="w-6 h-6 flex items-center justify-center bg-primary text-on-primary font-bold rounded-[2px] text-[11px]"
          title={`Current: ${part.title}`}
        >
          {part.part}
        </span>
      ) : part.slug ? (
        <a
          href={`/blog/${part.slug}`}
          class="w-6 h-6 flex items-center justify-center bg-surface-container border border-outline-variant text-on-surface-variant hover:text-primary hover:border-outline rounded-[2px] text-[11px] transition-colors"
          title={`Part ${part.part}: ${part.title}`}
        >
          [{part.part}]
        </a>
      ) : (
        <span
          class="w-6 h-6 flex items-center justify-center bg-surface-container/50 border border-outline-variant/50 text-outline rounded-[2px] text-[11px]"
          title={`Part ${part.part} (Upcoming)`}
        >
          {part.part}
        </span>
      )
    ))}
  </div>
</div>
